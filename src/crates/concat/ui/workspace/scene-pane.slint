import { Button } from "std-widgets.slint";
import { Pane, PaneHeader } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";
import { Rail } from "../inspector/controls.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";

// The scene pane's state, published by Rust (studio/publish.rs).
export global SceneView {
    in-out property <image> frame;
    in-out property <float> frame-number: 0;
    in-out property <int> max-frame: 0;
    in-out property <bool> has-scene: false;
    in-out property <bool> show-frame-slider: true;
    in-out property <string> status: "";
    callback open();
    callback seek(float);
    callback drag-camera(float, float);
    callback drag-ended();
    callback save();
    callback add-to-timeline();
}

// A concat-scene frame with its camera under the pointer, in the workspace.
export component ScenePane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    VerticalLayout {
        PaneHeader {
            title: I18n.t("paneSwitcher.scene");

            VerticalLayout {
                alignment: center;
                PaneSwitcher {
                    kind: PaneKind.scene;
                    seat: root.pane-seat;
                    removable: root.pane-removable;
                    picked(kind) => { root.pane-picked(kind); }
                    removed => { root.pane-removed(); }
                }
            }
        }

        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                Button {
                    text: I18n.t("scene.open");
                    clicked => { SceneView.open(); }
                }
                Button {
                    text: I18n.t("scene.addToTimeline");
                    enabled: SceneView.has-scene;
                    clicked => { SceneView.add-to-timeline(); }
                }
                Button {
                    text: I18n.t("scene.save");
                    enabled: SceneView.has-scene;
                    clicked => { SceneView.save(); }
                }
                Text {
                    text: SceneView.status;
                    color: Theme.fg-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #080a0d;
            clip: true;
            vertical-stretch: 1;

            Image {
                source: SceneView.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            touch := TouchArea {
                width: 100%;
                height: 100%;
                property <length> last-x: -1px;
                property <length> last-y: -1px;

                // The image is drawn with image-fit: contain, so the picture
                // is centred and may be letterboxed. Drags count only inside
                // this rectangle, in fractions of the picture (not the pane).
                property <length> picture-w: Math.max(1, SceneView.frame.width) * 1px;
                property <length> picture-h: Math.max(1, SceneView.frame.height) * 1px;
                property <float> fit: Math.min(touch.width / touch.picture-w, touch.height / touch.picture-h);
                property <length> shown-w: touch.picture-w * touch.fit;
                property <length> shown-h: touch.picture-h * touch.fit;
                property <length> shown-x: (touch.width - touch.shown-w) / 2;
                property <length> shown-y: (touch.height - touch.shown-h) / 2;

                moved() => {
                    if (SceneView.has-scene
                        && touch.last-x >= 0px
                        && touch.shown-w > 0px
                        && touch.shown-h > 0px
                        && touch.mouse-x >= touch.shown-x
                        && touch.mouse-x <= touch.shown-x + touch.shown-w
                        && touch.mouse-y >= touch.shown-y
                        && touch.mouse-y <= touch.shown-y + touch.shown-h
                        && touch.last-x >= touch.shown-x
                        && touch.last-x <= touch.shown-x + touch.shown-w
                        && touch.last-y >= touch.shown-y
                        && touch.last-y <= touch.shown-y + touch.shown-h) {
                        SceneView.drag-camera(
                            (touch.mouse-x - touch.last-x) / touch.shown-w,
                            (touch.mouse-y - touch.last-y) / touch.shown-h,
                        );
                    }
                    touch.last-x = touch.mouse-x;
                    touch.last-y = touch.mouse-y;
                }

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        touch.last-x = touch.mouse-x;
                        touch.last-y = touch.mouse-y;
                    } else if (event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel) {
                        touch.last-x = -1px;
                        touch.last-y = -1px;
                        SceneView.drag-ended();
                    }
                }
            }
        }

        if SceneView.show-frame-slider: Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: I18n.t("common.frame");
                    color: Theme.fg-muted;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    height: 32px;
                    border-radius: Theme.r-sm;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.field;

                    Rail {
                        x: 10px;
                        width: parent.width - 20px;
                        y: (parent.height - self.height) / 2;
                        value <=> SceneView.frame-number;
                        minimum: 0;
                        maximum: Math.max(1, SceneView.max-frame);
                        step: 1;
                        changed(value) => {
                            SceneView.seek(value);
                        }
                    }
                }
                Text {
                    text: Math.round(SceneView.frame-number) + " / " + SceneView.max-frame;
                    color: Theme.fg;
                    width: 84px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}