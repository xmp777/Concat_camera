import { Button, Slider } from "std-widgets.slint";
import { Pane, PaneHeader } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";

// The scene pane's state, published by Rust (studio/publish.rs).
export global SceneView {
    in-out property <image> frame;
    in-out property <float> frame-number: 0;
    in-out property <int> max-frame: 0;
    in-out property <string> status: "";
    callback open();
    callback seek(float);
    callback drag-camera(float, float);
    callback save();
}

// A concat-scene frame with its camera under the pointer, in the workspace.
export component ScenePane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    VerticalLayout {
        PaneHeader {
            title: I18n.t("paneSwitcher.scene");

            VerticalLayout {
                alignment: center;
                PaneSwitcher {
                    kind: PaneKind.scene;
                    seat: root.pane-seat;
                    removable: root.pane-removable;
                    picked(kind) => { root.pane-picked(kind); }
                    removed => { root.pane-removed(); }
                }
            }
        }

        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                Button {
                    text: I18n.t("scene.open");
                    clicked => { SceneView.open(); }
                }
                Button {
                    text: I18n.t("scene.save");
                    clicked => { SceneView.save(); }
                }
                Text {
                    text: SceneView.status;
                    color: Theme.fg-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #080a0d;
            clip: true;
            vertical-stretch: 1;

            Image {
                source: SceneView.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            touch := TouchArea {
                width: 100%;
                height: 100%;
                property <length> last-x: -1px;
                property <length> last-y: -1px;

                moved() => {
                    if (touch.last-x >= 0px && touch.width > 0px && touch.height > 0px) {
                        SceneView.drag-camera(
                            (touch.mouse-x - touch.last-x) / touch.width,
                            (touch.mouse-y - touch.last-y) / touch.height,
                        );
                    }
                    touch.last-x = touch.mouse-x;
                    touch.last-y = touch.mouse-y;
                }

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        touch.last-x = touch.mouse-x;
                        touch.last-y = touch.mouse-y;
                    } else if (event.kind == PointerEventKind.up) {
                        touch.last-x = -1px;
                        touch.last-y = -1px;
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: I18n.t("common.frame");
                    color: Theme.fg-muted;
                    vertical-alignment: center;
                }
                Slider {
                    minimum: 0;
                    maximum: SceneView.max-frame;
                    value: SceneView.frame-number;
                    changed(value) => {
                        SceneView.frame-number = value;
                        SceneView.seek(value);
                    }
                    horizontal-stretch: 1;
                }
                Text {
                    text: Math.round(SceneView.frame-number);
                    color: Theme.fg;
                    width: 52px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}