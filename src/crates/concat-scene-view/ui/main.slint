import { VerticalBox, HorizontalBox, Slider, Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    in property <image> frame;
    in-out property <float> frame-number: 0;
    in property <int> max-frame: 1;
    in-out property <string> status: "";
    callback seek(float);
    callback drag-camera(float, float);
    callback save();

    title: "2D Mini Studio - Scene View (spike)";
    preferred-width: 1200px;
    preferred-height: 760px;
    background: #14171c;

    VerticalBox {
        padding: 8px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            Text {
                text: "Frame";
                color: #aab4c0;
                vertical-alignment: center;
            }
            Slider {
                minimum: 0;
                maximum: root.max-frame;
                value: root.frame-number;
                changed(value) => {
                    root.frame-number = value;
                    root.seek(value);
                }
                horizontal-stretch: 1;
            }
            Text {
                text: Math.round(root.frame-number);
                color: #e8edf2;
                width: 48px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Button {
                text: "Save";
                clicked => { root.save(); }
            }
        }

        Rectangle {
            background: #080a0d;
            clip: true;
            vertical-stretch: 1;

            Image {
                source: root.frame;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }

            touch := TouchArea {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                property <length> last-x: -1px;
                property <length> last-y: -1px;

                moved() => {
                    if (touch.last-x >= 0px) {
                        root.drag-camera(
                            (touch.mouse-x - touch.last-x) / touch.width,
                            (touch.mouse-y - touch.last-y) / touch.height,
                        );
                    }
                    touch.last-x = touch.mouse-x;
                    touch.last-y = touch.mouse-y;
                }

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        touch.last-x = touch.mouse-x;
                        touch.last-y = touch.mouse-y;
                    } else if (event.kind == PointerEventKind.up) {
                        touch.last-x = -1px;
                        touch.last-y = -1px;
                    }
                }
            }
        }

        Text {
            text: root.status;
            color: #8b97a5;
        }
    }
}